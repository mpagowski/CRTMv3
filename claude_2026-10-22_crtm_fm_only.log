           +----                                                         
      1816 +  ! Subroutine to save the input adjoint aerosol concentratio
           +ns and                                                       
      1817 +  ! set them to zero, so that the adjoint of the scaled      
      1818 +  ! concentrations, c'_AD, can be accumulated separately.    
      1819 +  ! ---------------------------------------------------------
           +----                                                         
      1820 +  SUBROUTINE FineMode_Save_AD( &                             
      1821 +    Atm_AD    , &  ! AD In/Output                            
      1822 +    Conc_AD_in  )  ! Output, L x n_Aerosols                  
      1823 +    ! Arguments                                              
      1824 +    TYPE(CRTM_Atmosphere_type), INTENT(IN OUT) :: Atm_AD     
      1825 +    REAL(fp), ALLOCATABLE,      INTENT(OUT)    :: Conc_AD_in(
           +:,:)                                                         
      1826 +    ! Local variables                                        
      1827 +    INTEGER :: na, nl                                        
      1828 +                                                             
      1829 +    ALLOCATE( Conc_AD_in(Atm_AD%n_Layers, Atm_AD%n_Aerosols) 
           +)                                                            
      1830 +    Conc_AD_in = ZERO                                        
      1831 +    DO na = 1, Atm_AD%n_Aerosols                             
      1832 +      nl = Atm_AD%Aerosol(na)%n_Layers                       
      1833 +      Conc_AD_in(1:nl,na) = Atm_AD%Aerosol(na)%Concentration(
           +1:nl)                                                        
      1834 +      Atm_AD%Aerosol(na)%Concentration(1:nl) = ZERO          
      1835 +    END DO                                                   
      1836 +                                                             
      1837 +  END SUBROUTINE FineMode_Save_AD                            
      1838 +                                                             
      1839 +                                                             
      1840 +  ! ---------------------------------------------------------
           +----                                                         
      1841 +  ! Adjoint fine-mode scaling of the aerosol concentrations. 
           +On                                                           
      1842 +  ! input the Atm_AD concentrations hold c'_AD, the adjoint o
           +f the                                                        
      1843 +  ! scaled concentrations:                                   
      1844 +  !   RH_AD = RH_AD + f_RH.c.c'_AD                           
      1845 +  !   c_AD  = c_AD(input) + f.c'_AD                          
      1846 +  ! ---------------------------------------------------------
           +----                                                         
      1847 +  SUBROUTINE FineMode_Scale_AD( &                            
      1848 +    Atm       , &  ! FWD Input                               
      1849 +    f         , &  ! Input                                   
      1850 +    f_RH      , &  ! Input                                   
      1851 +    Conc_AD_in, &  ! Input                                   
      1852 +    Atm_AD      )  ! AD In/Output                            
      1853 +    ! Arguments                                              
      1854 +    TYPE(CRTM_Atmosphere_type), INTENT(IN)     :: Atm        
      1855 +    REAL(fp),                   INTENT(IN)     :: f(:,:)     
      1856 +    REAL(fp),                   INTENT(IN)     :: f_RH(:,:)  
      1857 +    REAL(fp),                   INTENT(IN)     :: Conc_AD_in(
           +:,:)                                                         
      1858 +    TYPE(CRTM_Atmosphere_type), INTENT(IN OUT) :: Atm_AD     
      1859 +    ! Local variables                                        
      1860 +    INTEGER :: na, nl                                        
      1861 +                                                             
      1862 +    DO na = 1, Atm%n_Aerosols                                
      1863 +      nl = Atm%Aerosol(na)%n_Layers                          
      1864 +      Atm_AD%Relative_Humidity(1:nl) = Atm_AD%Relative_Humidi
           +ty(1:nl) + &                                                 
      1865 +        f_RH(1:nl,na) * Atm%Aerosol(na)%Concentration(1:nl) *
           + Atm_AD%Aerosol(na)%Concentration(1:nl)                      
      1866 +      Atm_AD%Aerosol(na)%Concentration(1:nl) = Conc_AD_in(1:n
           +l,na) + &                                                    
      1867 +        f(1:nl,na) * Atm_AD%Aerosol(na)%Concentration(1:nl)  
      1868 +    END DO                                                   
      1869 +                                                             
      1870 +  END SUBROUTINE FineMode_Scale_AD                           
      1871 +                                                             
      1872  END MODULE CRTM_AOD_Module

