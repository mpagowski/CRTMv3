      1725 +  ! ---------------------------------------------------------
           +----                                                         
      1726 +  ! Subroutine to linearly interpolate fmass1 in relative hum
           +idity.                                                       
      1727 +  ! Outside the RH range of the table fmass1 is held constant
           +, so                                                         
      1728 +  ! its derivative is zero.                                  
      1729 +  ! ---------------------------------------------------------
           +----                                                         
      1730 +  SUBROUTINE Interpolate_fmass1( &                           
      1731 +    RH_LUT    , &  ! Input                                   
      1732 +    fmass1_LUT, &  ! Input                                   
      1733 +    RH        , &  ! Input                                   
      1734 +    f         , &  ! Output                                  
      1735 +    f_RH        )  ! Output, d(f)/d(RH)                      
      1736 +    ! Arguments                                              
      1737 +    REAL(fp), INTENT(IN)  :: RH_LUT(:)                       
      1738 +    REAL(fp), INTENT(IN)  :: fmass1_LUT(:)                   
      1739 +    REAL(fp), INTENT(IN)  :: RH                              
      1740 +    REAL(fp), INTENT(OUT) :: f                               
      1741 +    REAL(fp), INTENT(OUT) :: f_RH                            
      1742 +    ! Local variables                                        
      1743 +    INTEGER :: i, n                                          
      1744 +                                                             
      1745 +    n = SIZE(RH_LUT)                                         
      1746 +    IF ( RH <= RH_LUT(1) ) THEN                              
      1747 +      f    = fmass1_LUT(1)                                   
      1748 +      f_RH = ZERO                                            
      1749 +    ELSE IF ( RH >= RH_LUT(n) ) THEN                         
      1750 +      f    = fmass1_LUT(n)                                   
      1751 +      f_RH = ZERO                                            
      1752 +    ELSE                                                     
      1753 +      DO i = 1, n-1                                          
      1754 +        IF ( RH <= RH_LUT(i+1) ) EXIT                        
      1755 +      END DO                                                 
      1756 +      f_RH = (fmass1_LUT(i+1) - fmass1_LUT(i)) / (RH_LUT(i+1)
           + - RH_LUT(i))                                                
      1757 +      f    = fmass1_LUT(i) + f_RH * (RH - RH_LUT(i))         
      1758 +    END IF                                                   
      1759 +                                                             
      1760 +  END SUBROUTINE Interpolate_fmass1                          
